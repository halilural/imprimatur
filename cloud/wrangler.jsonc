// Imprimatur sync server (#61). Deploy: see README "Sync between machines".
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "imprimatur-sync",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "imprimatur-sync",
      // From `npx wrangler d1 create imprimatur-sync`.
      "database_id": "8baea550-1bbe-42e6-8d58-c1d36e92db68",
      "migrations_dir": "migrations"
    }
  ]
  // Secret: `npx wrangler secret put SYNC_TOKEN` (never in this file).
}
