// Imprimatur sync server (#61). Deploy: see README "Sync between machines".
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "imprimatur-sync",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "imprimatur-sync",
      // From `npx wrangler d1 create imprimatur-sync`.
      "database_id": "8baea550-1bbe-42e6-8d58-c1d36e92db68",
      "migrations_dir": "migrations"
    }
  ],
  // Live updates (#71): one SQLite-backed Durable Object per account holds every
  // device's WebSocket (hibernating); the Free plan has only SQLite-backed classes.
  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "Live" }]
  },
  // Applied by `wrangler deploy` (no separate step); a tag is never edited once deployed.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Live"] }]
  // Secrets: `npx wrangler secret put SYNC_TOKEN` and, for GitHub's webhook,
  // `npx wrangler secret put GITHUB_WEBHOOK_SECRET` (never in this file).
}
