{
  // Trees show only titles by default; commits and docs/todos/<N>/ refer to numbers.
  "githubIssues.showIssueNumberInTree": true,
  "githubPullRequests.showPullRequestNumberInTree": true,
  // Current sprint first, open and closed as separate queries (open oldest
  // first, closed most recently updated first), then epics, every open issue
  // and everything closed. The first two carry the sprint milestone title and
  // are renamed at every sprint planning (#35).
  "githubIssues.queries": [
    { "label": "Current Sprint · Open", "query": "state:open repo:${owner}/${repository} milestone:\"Sprint 2 · Oct 10–16 · The development process in Imprimatur\" sort:created-asc" },
    { "label": "Current Sprint · Closed", "query": "state:closed repo:${owner}/${repository} milestone:\"Sprint 2 · Oct 10–16 · The development process in Imprimatur\" sort:updated-desc" },
    { "label": "Epics", "query": "state:open label:epic repo:${owner}/${repository} sort:updated-desc" },
    { "label": "Open issues", "query": "state:open -label:epic repo:${owner}/${repository} sort:updated-desc" },
    { "label": "Closed issues", "query": "state:closed repo:${owner}/${repository} sort:updated-desc" }
  ],
  // The Issues tree has no auto refresh; cron-tasks calls its refresh command
  // every 10 minutes (once a minute used up the GitHub API limit together with
  // Claude's gh calls, investment #17).
  "cronTasks.tasks": [{ "at": "*/10 * * * *", "run": "issue.refresh" }]
}
