{
  "name": "agent-review",
  "displayName": "Agent Review",
  "description": "See an AI agent's edits in the editor like tracked changes until you accept them.",
  "version": "0.10.0",
  "publisher": "halilural",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./extension.js",
  "files": [
    "extension.js",
    "diff.js",
    "review-state.js",
    "preview.js",
    "preview.css",
    "graph.js",
    "graphView.js",
    "preview-markers.js"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agentReview.accept",
        "title": "Accept Agent Change at Cursor",
        "category": "Agent Review"
      },
      {
        "command": "agentReview.acceptAll",
        "title": "Accept All Agent Changes in File",
        "category": "Agent Review"
      },
      {
        "command": "agentReview.showHistory",
        "title": "Show Agent Edit History",
        "category": "Agent Review",
        "icon": "$(history)"
      },
      {
        "command": "agentReview.openGraph",
        "title": "Open Agent Change Graph",
        "category": "Agent Review",
        "icon": "$(git-merge)"
      },
      {
        "command": "agentReview.acceptRange",
        "title": "Accept Agent Changes in Range",
        "category": "Agent Review"
      }
    ],
    "colors": [
      {
        "id": "agentReview.changedLineBackground",
        "description": "Background of a line the agent changed.",
        "defaults": {
          "dark": "#1f6feb1f",
          "light": "#0969da14",
          "highContrast": "#1f6feb33",
          "highContrastLight": "#0969da22"
        }
      },
      {
        "id": "agentReview.deletedForeground",
        "description": "Text the agent deleted, shown struck through.",
        "defaults": {
          "dark": "#f85149",
          "light": "#cf222e",
          "highContrast": "#ff6a69",
          "highContrastLight": "#a40e26"
        }
      },
      {
        "id": "agentReview.earlierAddedBackground",
        "description": "Background of a line added in an earlier agent edit.",
        "defaults": {
          "dark": "#2ea0431f",
          "light": "#1a7f3714",
          "highContrast": "#2ea0432a",
          "highContrastLight": "#1a7f371f"
        }
      },
      {
        "id": "agentReview.earlierChangedBackground",
        "description": "Background of a line changed in an earlier agent edit.",
        "defaults": {
          "dark": "#1f6feb14",
          "light": "#0969da0f",
          "highContrast": "#1f6feb22",
          "highContrastLight": "#0969da1a"
        }
      },
      {
        "id": "agentReview.earlierInsertedTextBackground",
        "description": "New words from an earlier agent edit.",
        "defaults": {
          "dark": "#2ea04333",
          "light": "#1a7f3726",
          "highContrast": "#2ea04340",
          "highContrastLight": "#1a7f3733"
        }
      },
      {
        "id": "agentReview.earlierDeletedForeground",
        "description": "Deleted text from an earlier agent edit.",
        "defaults": {
          "dark": "#f8514980",
          "light": "#cf222e80",
          "highContrast": "#ff6a69a6",
          "highContrastLight": "#a40e26a6"
        }
      },
      {
        "id": "agentReview.oldTextForeground",
        "description": "Old text the agent replaced (struck through, kept readable).",
        "defaults": {
          "dark": "#c9d1d9cc",
          "light": "#57606acc",
          "highContrast": "#ffffffcc",
          "highContrastLight": "#000000cc"
        }
      },
      {
        "id": "agentReview.earlierOldTextForeground",
        "description": "Old text from an earlier agent edit.",
        "defaults": {
          "dark": "#c9d1d980",
          "light": "#57606a80",
          "highContrast": "#ffffff99",
          "highContrastLight": "#00000099"
        }
      },
      {
        "id": "agentReview.oldTextBackground",
        "description": "Band behind old text the agent replaced.",
        "defaults": {
          "dark": "#f851491f",
          "light": "#cf222e14",
          "highContrast": "#f8514933",
          "highContrastLight": "#cf222e22"
        }
      }
    ],
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./preview.css"
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "agentReview.acceptRange",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Agent Review",
      "properties": {
        "agentReview.showIn": {
          "type": "string",
          "enum": [
            "preview",
            "both",
            "editor"
          ],
          "enumDescriptions": [
            "Markdown: marks only in the Markdown preview (other files: editor).",
            "Markdown: marks in both the preview and the editor.",
            "Markdown: marks only in the editor."
          ],
          "default": "preview",
          "description": "Where agent changes to Markdown files are marked. Other file types are always marked in the editor."
        }
      }
    },
    "markdown.previewScripts": [
      "./preview-markers.js"
    ]
  }
}
