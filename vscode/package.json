        "title": "Reopen Task",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.records.reveal",
        "title": "Reveal Record",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.records.allRepos",
        "title": "Show Every Repo",
        "category": "Imprimatur",
