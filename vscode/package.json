{
  "name": "imprimatur",
  "displayName": "Imprimatur",
  "description": "See every doc edit your AI agent makes as tracked changes until you accept it.",
  "version": "0.40.0",
  "publisher": "halilural",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#fff1e3",
    "theme": "light"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/extension.js",
    "preview.css",
    "preview-markers.js",
    "media/imprimatur.svg",
    "media/icon.png"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:imprimatur.graph"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted folder Imprimatur shows changes and records but starts no model calls (claude), gh or repo scripts."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "imprimatur.accept",
        "title": "Accept Agent Change at Cursor",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.acceptAll",
        "title": "Accept All Agent Changes in File",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.showHistory",
        "title": "Show Agent Edit History",
        "category": "Imprimatur",
        "icon": "$(history)"
      },
      {
        "command": "imprimatur.openGraph",
        "title": "Open Agent Change Graph",
        "category": "Imprimatur",
        "icon": "$(git-merge)"
      },
      {
        "command": "imprimatur.acceptRange",
        "title": "Accept Agent Changes in Range",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.graph.acceptEdit",
        "title": "Accept this edit",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.graph.openDiff",
        "title": "Open diff",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.graph.markDone",
        "title": "Mark as done",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.graph.copyAsk",
        "title": "Copy what to do",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.graph.goTo",
        "title": "Go to change",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.setup.refresh",
        "title": "Refresh",
        "category": "Imprimatur",
        "icon": "$(refresh)"
      },
      {
        "command": "imprimatur.setup.markSeen",
        "title": "Mark all as seen",
        "category": "Imprimatur",
        "icon": "$(check-all)"
      },
      {
        "command": "imprimatur.setup.compareVariant",
        "title": "Compare with Another Repo's Copy",
        "category": "Imprimatur",
        "icon": "$(diff)"
      },
      {
        "command": "imprimatur.setup.explainLastChange",
        "title": "Explain Last Change",
        "category": "Imprimatur",
        "icon": "$(sparkle)"
      },
      {
        "command": "imprimatur.importMarkdown",
        "title": "Import Markdown Records (TODO.md, design, product, tests)",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.archiveNow",
        "title": "Archive Old Agent Edits and Asks Now",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.syncNow",
        "title": "Sync Now",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.records.refresh",
        "title": "Refresh Records",
        "category": "Imprimatur",
        "icon": "$(refresh)"
      },
      {
        "command": "imprimatur.records.search",
        "title": "Search Records",
        "category": "Imprimatur",
        "icon": "$(search)"
      },
      {
        "command": "imprimatur.records.show",
        "title": "Show Record",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.records.done",
        "title": "Mark Done",
        "category": "Imprimatur",
        "icon": "$(check)"
      },
      {
        "command": "imprimatur.records.reopen",
        "title": "Reopen",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.records.drop",
        "title": "Drop",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.records.pointer",
        "title": "Move 👉 Here",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.records.editTitle",
        "title": "Edit Title…",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.records.copy",
        "title": "Copy Text",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.records.add",
        "title": "Add Record…",
        "category": "Imprimatur",
        "icon": "$(add)"
      },
      {
        "command": "imprimatur.records.taskDone",
        "title": "Mark Task Done",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.records.taskReopen",
        "title": "Reopen Task",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.records.reveal",
        "title": "Reveal Record",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.records.allRepos",
        "title": "Show Every Repo",
        "category": "Imprimatur",
        "icon": "$(globe)"
      },
      {
        "command": "imprimatur.records.thisWindow",
        "title": "Show This Window's Repos Only",
        "category": "Imprimatur",
        "icon": "$(root-folder)"
      },
      {
        "command": "imprimatur.processOn",
        "title": "Turn On Process Checks for This Repo",
        "category": "Imprimatur"
      }
    ],
    "colors": [
      {
        "id": "imprimatur.changedLineBackground",
        "description": "Background of a line the agent changed.",
        "defaults": {
          "dark": "#1f6feb1f",
          "light": "#0969da14",
          "highContrast": "#1f6feb33",
          "highContrastLight": "#0969da22"
        }
      },
      {
        "id": "imprimatur.deletedForeground",
        "description": "Text the agent deleted, shown struck through.",
        "defaults": {
          "dark": "#f85149",
          "light": "#cf222e",
          "highContrast": "#ff6a69",
          "highContrastLight": "#a40e26"
        }
      },
      {
        "id": "imprimatur.oldTextForeground",
        "description": "Old text the agent replaced (struck through, kept readable).",
        "defaults": {
          "dark": "#c9d1d9cc",
          "light": "#57606acc",
          "highContrast": "#ffffffcc",
          "highContrastLight": "#000000cc"
        }
      },
      {
        "id": "imprimatur.oldTextBackground",
        "description": "Band behind old text the agent replaced.",
        "defaults": {
          "dark": "#f851491f",
          "light": "#cf222e14",
          "highContrast": "#f8514933",
          "highContrastLight": "#cf222e22"
        }
      }
    ],
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./preview.css"
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "imprimatur.acceptRange",
          "when": "false"
        },
        {
          "command": "imprimatur.graph.acceptEdit",
          "when": "false"
        },
        {
          "command": "imprimatur.graph.openDiff",
          "when": "false"
        },
        {
          "command": "imprimatur.graph.markDone",
          "when": "false"
        },
        {
          "command": "imprimatur.graph.copyAsk",
          "when": "false"
        },
        {
          "command": "imprimatur.graph.goTo",
          "when": "false"
        },
        {
          "command": "imprimatur.records.show",
          "when": "false"
        },
        {
          "command": "imprimatur.records.done",
          "when": "false"
        },
        {
          "command": "imprimatur.records.reopen",
          "when": "false"
        },
        {
          "command": "imprimatur.records.drop",
          "when": "false"
        },
        {
          "command": "imprimatur.records.pointer",
          "when": "false"
        },
        {
          "command": "imprimatur.records.editTitle",
          "when": "false"
        },
        {
          "command": "imprimatur.records.copy",
          "when": "false"
        },
        {
          "command": "imprimatur.records.add",
          "when": "false"
        },
        {
          "command": "imprimatur.records.taskDone",
          "when": "false"
        },
        {
          "command": "imprimatur.records.taskReopen",
          "when": "false"
        },
        {
          "command": "imprimatur.records.reveal",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "imprimatur.graph.acceptEdit",
          "when": "webviewId == 'imprimatur.graph' && webviewSection == 'edit-open'",
          "group": "1_review@1"
        },
        {
          "command": "imprimatur.graph.goTo",
          "when": "webviewId == 'imprimatur.graph' && webviewSection =~ /^edit-/",
          "group": "1_review@2"
        },
        {
          "command": "imprimatur.graph.openDiff",
          "when": "webviewId == 'imprimatur.graph' && webviewSection =~ /^edit-/",
          "group": "1_review@3"
        },
        {
          "command": "imprimatur.graph.markDone",
          "when": "webviewId == 'imprimatur.graph' && webviewSection == 'waiting-open'",
          "group": "1_review@1"
        },
        {
          "command": "imprimatur.graph.copyAsk",
          "when": "webviewId == 'imprimatur.graph' && webviewSection =~ /^waiting-/",
          "group": "1_review@2"
        }
      ],
      "view/title": [
        {
          "command": "imprimatur.openGraph",
          "when": "view == imprimatur.setup",
          "group": "navigation@1"
        },
        {
          "command": "imprimatur.setup.markSeen",
          "when": "view == imprimatur.setup",
          "group": "navigation@2"
        },
        {
          "command": "imprimatur.setup.refresh",
          "when": "view == imprimatur.setup",
          "group": "navigation@3"
        },
        {
          "command": "imprimatur.records.search",
          "when": "view =~ /^imprimatur\\.records\\./",
          "group": "navigation@1"
        },
        {
          "command": "imprimatur.records.refresh",
          "when": "view =~ /^imprimatur\\.records\\./",
          "group": "navigation@2"
        },
        {
          "command": "imprimatur.records.allRepos",
          "when": "view =~ /^imprimatur\\.records\\./ && !imprimatur.records.allRepos",
          "group": "navigation@3"
        },
        {
          "command": "imprimatur.records.thisWindow",
          "when": "view =~ /^imprimatur\\.records\\./ && imprimatur.records.allRepos",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "imprimatur.setup.compareVariant",
          "when": "view == imprimatur.setup && viewItem =~ /^setupFile-drift/",
          "group": "inline@1"
        },
        {
          "command": "imprimatur.setup.compareVariant",
          "when": "view == imprimatur.setup && viewItem =~ /^setupFile-drift/",
          "group": "1_setup@1"
        },
        {
          "command": "imprimatur.setup.explainLastChange",
          "when": "view == imprimatur.setup && viewItem =~ /^setupFile.*-repo/",
          "group": "1_setup@2"
        },
        {
          "command": "imprimatur.records.done",
          "when": "view =~ /^imprimatur\\.records\\./ && viewItem =~ /^record-open/",
          "group": "inline@1"
        },
        {
          "command": "imprimatur.records.done",
          "when": "view =~ /^imprimatur\\.records\\./ && viewItem =~ /^record-open/",
          "group": "1_state@1"
        },
        {
          "command": "imprimatur.records.reopen",
          "when": "view =~ /^imprimatur\\.records\\./ && viewItem =~ /^record-(done|dropped)/",
          "group": "1_state@2"
        },
        {
          "command": "imprimatur.records.drop",
          "when": "view =~ /^imprimatur\\.records\\./ && viewItem =~ /^record-open/",
          "group": "1_state@3"
        },
        {
          "command": "imprimatur.records.pointer",
          "when": "view =~ /^imprimatur\\.records\\./ && viewItem == record-open",
          "group": "1_state@4"
        },
        {
          "command": "imprimatur.records.editTitle",
          "when": "view =~ /^imprimatur\\.records\\./ && viewItem =~ /^record-/",
          "group": "2_edit@1"
        },
        {
          "command": "imprimatur.records.add",
          "when": "view =~ /^imprimatur\\.records\\./ && viewItem =~ /^(record-|task-)/",
          "group": "2_edit@2"
        },
        {
          "command": "imprimatur.records.copy",
          "when": "view =~ /^imprimatur\\.records\\./ && viewItem =~ /^record-/",
          "group": "3_copy@1"
        },
        {
          "command": "imprimatur.records.add",
          "when": "view =~ /^imprimatur\\.records\\./ && viewItem =~ /^task-/",
          "group": "inline@1"
        },
        {
          "command": "imprimatur.records.taskDone",
          "when": "view =~ /^imprimatur\\.records\\./ && viewItem == task-live",
          "group": "1_state@1"
        },
        {
          "command": "imprimatur.records.taskReopen",
          "when": "view =~ /^imprimatur\\.records\\./ && viewItem == task-closed",
          "group": "1_state@1"
        }
      ]
    },
    "configuration": {
      "title": "Imprimatur",
      "properties": {
        "imprimatur.showIn": {
          "type": "string",
          "enum": [
            "preview",
            "both",
            "editor"
          ],
          "enumDescriptions": [
            "Markdown: marks only in the Markdown preview (other files: editor).",
            "Markdown: marks in both the preview and the editor.",
            "Markdown: marks only in the editor."
          ],
          "default": "preview",
          "description": "Where agent changes to Markdown files are marked. Other file types are always marked in the editor."
        },
        "imprimatur.language": {
          "type": "string",
          "default": "",
          "markdownDescription": "Language of the steps Scan history and Audit write, e.g. `Turkish`. Empty: the agent's language (the hooks use `IMPRIMATUR_LANG`). `npm run setup -- --lang …` sets both."
        },
        "imprimatur.editorAlsoFor": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Glob patterns of Markdown files that also get marks in the editor when `#imprimatur.showIn#` is `preview`, e.g. `**/todos/**`."
        },
        "imprimatur.setup.driftRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "~/projects"
          ],
          "markdownDescription": "Agent setup drift: besides the window's repos, the git repos one level under these folders are compared. A file with the same path in several repos (e.g. `.claude/hooks/x.sh`) shows `differs in N of M repos` when the copies differ."
        },
        "imprimatur.setup.driftExclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "CLAUDE.md",
            "CLAUDE.local.md",
            ".claude/settings.local.json"
          ],
          "markdownDescription": "Agent files left out of drift because they are meant to differ per repo: a file name (`CLAUDE.md`, in any folder), a path (`.claude/settings.json`) or a folder ending in `/` (`.cursor/rules/`)."
        },
        "imprimatur.mermaidDiff": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Color what the agent changed inside Mermaid flowcharts in the preview (adds style lines to the rendered diagram). Off by default: with two Mermaid preview extensions installed (e.g. Mermaid Chart and Markdown Mermaid Zoom) the diagrams can fail to render."
        },
        "imprimatur.archive.afterDays": {
          "type": "number",
          "default": 7,
          "minimum": 0,
          "markdownDescription": "After this many days an agent edit counts as accepted and leaves review; its history, and waiting logs with nothing open, move to `.claude/imprimatur/archive/<date>/` (gzipped, read with `zcat`). Runs once a day per repo; **Imprimatur: Archive Old Agent Edits and Asks Now** runs it at once. `0`: never."
        }
      }
    },
    "markdown.previewScripts": [
      "./preview-markers.js"
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "imprimatur",
          "title": "Imprimatur",
          "icon": "media/imprimatur.svg"
        }
      ]
    },
    "views": {
      "imprimatur": [
        {
          "id": "imprimatur.records.asks",
          "name": "Waiting on me",
          "contextualTitle": "Imprimatur"
        },
        {
          "id": "imprimatur.records.tasks",
          "name": "Tasks",
          "contextualTitle": "Imprimatur"
        },
        {
          "id": "imprimatur.records.questions",
          "name": "Questions",
          "contextualTitle": "Imprimatur",
          "visibility": "collapsed"
        },
        {
          "id": "imprimatur.records.decisions",
          "name": "Decisions",
          "contextualTitle": "Imprimatur",
          "visibility": "collapsed"
        },
        {
          "id": "imprimatur.records.adr",
          "name": "Architecture (ADR)",
          "contextualTitle": "Imprimatur",
          "visibility": "collapsed"
        },
        {
          "id": "imprimatur.records.pdr",
          "name": "Product (PDR)",
          "contextualTitle": "Imprimatur",
          "visibility": "collapsed"
        },
        {
          "id": "imprimatur.setup",
          "name": "Agent setup",
          "contextualTitle": "Imprimatur"
        }
      ]
    }
  }
}
