{
  "name": "imprimatur",
  "displayName": "Imprimatur",
  "description": "See every doc edit your AI agent makes as tracked changes until you accept it.",
  "version": "0.69.0",
  "publisher": "halilural",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#fff1e3",
    "theme": "light"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/halilural/imprimatur.git"
  },
  "bugs": {
    "url": "https://github.com/halilural/imprimatur/issues"
  },
  "homepage": "https://github.com/halilural/imprimatur#readme",
  "keywords": [
    "ai",
    "agent",
    "claude",
    "claude code",
    "review",
    "tracked changes",
    "markdown",
    "mcp"
  ],
  "pricing": "Free",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/extension.js",
    "dist/mermaid.min.js",
    "preview.css",
    "preview-markers.js",
    "media/imprimatur.svg",
    "media/icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:imprimatur.graph"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted folder Imprimatur shows changes and records but starts no model calls (claude), gh or repo scripts."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "imprimatur.accept",
        "title": "Accept Agent Change at Cursor",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.acceptAll",
        "title": "Accept All Agent Changes in File",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.showHistory",
        "title": "Show Agent Edit History",
        "category": "Imprimatur",
        "icon": "$(history)"
      },
      {
        "command": "imprimatur.openGraph",
        "title": "Open Agent Change Graph",
        "category": "Imprimatur",
        "icon": "$(git-merge)"
      },
      {
        "command": "imprimatur.openHome",
        "title": "Open Home",
        "category": "Imprimatur",
        "icon": "$(home)"
      },
      {
        "command": "imprimatur.openTasks",
        "title": "Open Tasks",
        "category": "Imprimatur",
        "icon": "$(checklist)"
      },
      {
        "command": "imprimatur.openInbox",
        "title": "Open Waiting on You",
        "category": "Imprimatur",
        "icon": "$(bell)"
      },
      {
        "command": "imprimatur.openArchitecture",
        "title": "Open Architecture Document",
        "category": "Imprimatur",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "imprimatur.openProduct",
        "title": "Open Product Document",
        "category": "Imprimatur",
        "icon": "$(package)"
      },
      {
        "command": "imprimatur.openGlossary",
        "title": "Open Project Glossary",
        "category": "Imprimatur",
        "icon": "$(book)"
      },
      {
        "command": "imprimatur.docs.reveal",
        "title": "Show a Design Document Section",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.acceptRange",
        "title": "Accept Agent Changes in Range",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.graph.acceptEdit",
        "title": "Accept this edit",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.graph.openDiff",
        "title": "Open diff",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.graph.markDone",
        "title": "Mark as done",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.graph.copyAsk",
        "title": "Copy what to do",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.graph.goTo",
        "title": "Go to change",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.setup.refresh",
        "title": "Refresh",
        "category": "Imprimatur",
        "icon": "$(refresh)"
      },
      {
        "command": "imprimatur.setup.markSeen",
        "title": "Mark all as seen",
        "category": "Imprimatur",
        "icon": "$(check-all)"
      },
      {
        "command": "imprimatur.setup.compareVariant",
        "title": "Compare with Another Repo's Copy",
        "category": "Imprimatur",
        "icon": "$(diff)"
      },
      {
        "command": "imprimatur.setup.explainLastChange",
        "title": "Explain Last Change",
        "category": "Imprimatur",
        "icon": "$(sparkle)"
      },
      {
        "command": "imprimatur.bestPractices.run",
        "title": "Review Project Best Practices (Claude)",
        "category": "Imprimatur",
        "icon": "$(sparkle)"
      },
      {
        "command": "imprimatur.setup.audit",
        "title": "Recommendations…",
        "category": "Imprimatur",
        "icon": "$(lightbulb)"
      },
      {
        "command": "imprimatur.setup.auditAgent",
        "title": "Audit Agent Setup (agnix)",
        "category": "Imprimatur",
        "icon": "$(hubot)"
      },
      {
        "command": "imprimatur.setup.applyFinding",
        "title": "Mark Recommendation Applied",
        "category": "Imprimatur",
        "icon": "$(check)"
      },
      {
        "command": "imprimatur.setup.dismissFinding",
        "title": "Dismiss Recommendation…",
        "category": "Imprimatur",
        "icon": "$(circle-slash)"
      },
      {
        "command": "imprimatur.setup.reopenFinding",
        "title": "Reopen Recommendation",
        "category": "Imprimatur",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "imprimatur.importMarkdown",
        "title": "Import Markdown Records (TODO.md, design, product, tests)",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.analysisBackfill",
        "title": "Take Task Analyses from Past Sessions",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.archiveNow",
        "title": "Archive Old Agent Edits and Asks Now",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.pluginActions",
        "title": "Plugin Actions…",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.trackerSync",
        "title": "Sync with Issue Tracker",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.records.refresh",
        "title": "Refresh Records",
        "category": "Imprimatur",
        "icon": "$(refresh)"
      },
      {
        "command": "imprimatur.records.search",
        "title": "Search Records",
        "category": "Imprimatur",
        "icon": "$(search)"
      },
      {
        "command": "imprimatur.records.show",
        "title": "Show Record",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.records.done",
        "title": "Mark Done",
        "category": "Imprimatur",
        "icon": "$(check)"
      },
      {
        "command": "imprimatur.records.reopen",
        "title": "Reopen",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.records.drop",
        "title": "Drop",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.records.pointer",
        "title": "Move 👉 Here",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.records.editTitle",
        "title": "Edit Title…",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.records.copy",
        "title": "Copy Text",
        "category": "Imprimatur"
      },
      {
        "command": "imprimatur.records.add",
        "title": "Add Record…",
        "category": "Imprimatur",
        "icon": "$(add)"
      },
      {
        "command": "imprimatur.records.taskDone",
        "title": "Mark Task Done",
        "category": "Imprimatur"
      },
      {
